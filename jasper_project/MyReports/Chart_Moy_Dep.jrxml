		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Occitanie_DB"/>
		<query language="SQL"><![CDATA[SELECT 
    INSEE_DEP AS Department,
    AVG(Rendement_locatif_apparts) AS Avg_Rendement_Apparts
FROM 
    communes_data
GROUP BY 
    INSEE_DEP
ORDER BY 
    Avg_Rendement_Apparts DESC
]]></query>
