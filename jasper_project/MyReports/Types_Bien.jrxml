<jasperReport name="Types_Bien" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="cc0b2249-64ea-450b-8770-1f04cff8c79c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
