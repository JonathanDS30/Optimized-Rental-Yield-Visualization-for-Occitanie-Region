	<dataset name="PieChart_Biens" uuid="13c2859a-c904-4b7d-81de-9164916da944">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Occitanie_DB"/>
		<query language="SQL"><![CDATA[SELECT
    INSEE_DEP,
    SUM(loyer_apparts) AS total_loyer_apparts,
    SUM(loyer_maisons) AS total_loyer_maisons,
    (SUM(loyer_apparts) / (SELECT SUM(loyer_apparts) FROM communes_data)) * 100 AS percent_apparts,
    (SUM(loyer_maisons) / (SELECT SUM(loyer_maisons) FROM communes_data)) * 100 AS percent_maisons
FROM
    communes_data
GROUP BY
    INSEE_DEP
]]></query>
		<field name="INSEE_DEP" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="INSEE_DEP"/>
			<property name="com.jaspersoft.studio.field.label" value="INSEE_DEP"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="communes_data"/>
		</field>
