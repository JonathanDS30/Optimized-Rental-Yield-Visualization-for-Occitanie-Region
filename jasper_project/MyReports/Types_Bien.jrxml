		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BDD_Immo"/>
		<query language="SQL"><![CDATA[SELECT 
    INSEE_DEP,
    SUM(loyer_apparts) AS total_loyer_apparts,
    SUM(loyer_maisons) AS total_loyer_maisons
