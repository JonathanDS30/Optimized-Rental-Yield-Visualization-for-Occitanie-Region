		<field name="percent_maisons" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="percent_maisons"/>
			<property name="com.jaspersoft.studio.field.label" value="percent_maisons"/>
		</field>
	</dataset>
	<query language="SQL"><![CDATA[SELECT `INSEE_COM`,
	`INSEE_DEP`,
