	<summary height="613" splitType="Stretch">
		<element kind="chart" chartType="pie" uuid="91c5417e-c4f7-45d1-800f-b61dd5d83434" x="-3" y="10" width="560" height="230" showLegend="false" evaluationTime="Report">
			<titleFont fontSize="14.0" bold="true"/>
			<titleExpression><![CDATA["Répartition de la Population par Département en Occitanie"]]></titleExpression>
			<dataset kind="pie">
				<datasetRun uuid="4b89d6a6-965a-47c7-beb8-3956ba501d7f" subDataset="Démographie"/>
				<series>
					<keyExpression><![CDATA[$F{Département}]]></keyExpression>
					<valueExpression><![CDATA[$F{Population_Totale}]]></valueExpression>
					<labelExpression><![CDATA[$F{Département} + " (" + new java.text.DecimalFormat("#,###").format($F{Population_Totale}) + " habitant)"]]></labelExpression>
				</series>
			</dataset>
			<plot>
				<itemLabel/>
			</plot>
		</element>
		<element kind="staticText" uuid="f454a234-91d5-4a08-821a-51666f14b399" x="16" y="470" width="523" height="70">
			<text><![CDATA[Les graphiques illustrent la répartition de la population et le taux de chômage par département en région Occitanie. La Haute-Garonne (31) et l'Hérault (34) regroupent la majorité des habitants, tandis que des départements comme le Lot (46) et la Lozère (48) ont une population nettement plus faible. Concernant le chômage, les Pyrénées-Orientales (66) et l'Hérault (34) affichent les taux les plus élevés, tandis que le Gers (32) et la Lozère (48) se distinguent par des taux plus faibles, révélant des disparités démographiques et économiques marquées.]]></text>
		</element>
		<element kind="chart" chartType="bar" uuid="e5ffef08-1336-4104-917d-b969b0f768b6" x="7" y="270" width="540" height="180" evaluationTime="Report" theme="default">
			<titleFont fontSize="14.0" bold="true"/>
			<titleExpression><![CDATA["Taux de Chômage par Département en Occitanie"]]></titleExpression>
			<dataset kind="category">
				<datasetRun uuid="90bd55f2-c694-4f5a-ad98-8c2cf4c4b5a9" subDataset="Taux de chomage par département">
					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				</datasetRun>
				<series>
					<seriesExpression><![CDATA["Taux de chômage par département"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{Département}]]></categoryExpression>
					<valueExpression><![CDATA[$F{Taux_Chomage_2022}]]></valueExpression>
					<labelExpression><![CDATA[$F{Taux_Chomage_2022} + " %" ]]></labelExpression>
					<itemHyperlink linkType="None" linkTarget="Self"/>
				</series>
			</dataset>
			<plot foregroundAlpha="0.94" categoryAxisLabelColor="#000000" categoryAxisTickLabelColor="#000000" categoryAxisLineColor="#000000" valueAxisLabelColor="#000000" valueAxisTickLabelColor="#000000" valueAxisLineColor="#000000">
				<itemLabel/>
				<seriesColor order="0" color="#C90000"/>
				<seriesColor order="1" color="#FFD700"/>
			</plot>
		</element>
		<element kind="staticText" uuid="0787946f-cf54-4d92-a34f-d3af20685a3c" x="6" y="560" width="542" height="30">
			<text><![CDATA[09 - Ariège | 11 - Aude | 12 - Aveyron | 30 - Gard | 31 - Haute-Garonne | 32 - Gers | 34 - Hérault | 46 - Lot | 48 - Lozère | 65 -  Hautes-Pyrénées | 66 - Pyrénées-Orientales | 81 - Tarn | 82 - Tarn-et-Garonne]]></text>
