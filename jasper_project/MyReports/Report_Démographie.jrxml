	<dataset name="Démographie" uuid="8c4e96d3-7bf0-4af4-8b01-b88c37c6140d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Occitanie_DB"/>
		<query language="SQL"><![CDATA[SELECT 
    INSEE_DEP AS Département,
    SUM(POPULATION) AS Population_Totale
FROM 
    occitanie_yield_db.communes_data
GROUP BY 
    INSEE_DEP
ORDER BY 
    INSEE_DEP;
]]></query>
		<field name="Département" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="INSEE_DEP"/>
			<property name="com.jaspersoft.studio.field.label" value="Département"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="communes_data"/>
		</field>
		<field name="Population_Totale" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="Population_Totale"/>
			<property name="com.jaspersoft.studio.field.label" value="Population_Totale"/>
		</field>
	</dataset>
