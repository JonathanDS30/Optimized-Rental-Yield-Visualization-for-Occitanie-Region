	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Occitanie_DB"/>
	<query language="SQL"><![CDATA[SELECT 
    PrixMoyen_M2_2223,
    Rendement_locatif_apparts,
    Rendement_locatif_maisons
FROM 
    communes_data
WHERE 
    PrixMoyen_M2_2223 > 0
    AND (Rendement_locatif_apparts > 0 OR Rendement_locatif_maisons > 0)
]]></query>
