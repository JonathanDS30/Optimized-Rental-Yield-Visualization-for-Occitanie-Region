<jasperReport name="histo_prix_moy_mcarre" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="286295fc-ac79-418a-878e-7192dcf8a10b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_Occitanie_DB"/>
	<dataset name="DATASET_HISTO_PRIX_MCARRE" uuid="d18f49ed-bd6c-44bf-9b99-ea52bb060f40">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IMMO_BDD"/>
		<query language="SQL"><![CDATA[SELECT 
    CASE  
        WHEN (PrixMoyen_M2_2223 < 1000) THEN '0-1000'
        WHEN (PrixMoyen_M2_2223 < 2000) THEN '1000-2000'
        WHEN (PrixMoyen_M2_2223 < 3000) THEN '2000-3000'
        WHEN (PrixMoyen_M2_2223 < 4000) THEN '3000-4000'
        WHEN (PrixMoyen_M2_2223 < 5000) THEN '4000-5000'
        ELSE '5000+'
    END AS Tranche_Prix,
    COUNT(*) AS Nombre_Communes
FROM communes_data
GROUP BY Tranche_Prix
ORDER BY Tranche_Prix]]></query>
		<field name="Tranche_Prix" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Tranche_Prix"/>
			<property name="com.jaspersoft.studio.field.label" value="Tranche_Prix"/>
		</field>
		<field name="Nombre_Communes" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="Nombre_Communes"/>
			<property name="com.jaspersoft.studio.field.label" value="Nombre_Communes"/>
		</field>
	</dataset>
	<query language="SQL"><![CDATA[SELECT `INSEE_COM`,
	`INSEE_DEP`,
	`NOM_COM_M`,
	`POPULATION`,
	`PrixMoyen_M2_2223`,
	`Prixm2Moyen_2022`,
	`Prixm2Moyen_2023`,
	loyer_apparts,
	loyer_maisons,
	`Rendement_locatif_apparts`,
	`Rendement_locatif_maisons`
FROM occitanie_yield_db.communes_data]]></query>
